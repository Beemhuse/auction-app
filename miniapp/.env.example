# Absolute API origin for a deployed build. Leave empty in development to use the Vite proxy.
VITE_API_URL=
# Where the dev server proxies /api and /ws.
VITE_PROXY_TARGET=http://127.0.0.1:3010
# Path the app is served under, e.g. /auction/ when hosted at https://example.com/auction/
VITE_BASE_PATH=/
# Development only: signed Telegram initData, for opening the app in a normal browser.
# Generate one with `node scripts/dev-init-data.mjs` (reads TELEGRAM_BOT_TOKEN from ../server/.env).
VITE_DEV_INIT_DATA=
