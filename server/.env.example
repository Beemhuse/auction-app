NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://hammer:hammer@localhost:5436/hammer
# Postgres TLS: empty/disable (private networks), require (encrypt only), verify (encrypt + verify cert)
DATABASE_SSL=
REDIS_URL=redis://localhost:6379
TELEGRAM_BOT_TOKEN=replace-me
# Only one process may poll a bot. Set to false locally while production uses the same bot.
TELEGRAM_BOT_ENABLED=true
ENTRY_CODE_SECRET=replace-with-at-least-32-characters
PAYSTACK_SECRET_KEY=sk_test_replace-me
PAYSTACK_BASE_URL=https://api.paystack.co
MINI_APP_URL=https://example.test/auction
CORS_ORIGINS=https://example.test
ADMIN_API_KEY=replace-with-at-least-24-characters
