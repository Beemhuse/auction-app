{
  "name": "project-hammer-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "npm run migration:deploy && node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "migration:run": "npm run build && node node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "migration:deploy": "typeorm migration:run -d dist/database/data-source.js",
    "seed": "npm run build && node dist/database/seed.js",
    "schema:check": "npm run build && node dist/database/check-schema.js",
    "client:generate": "openapi-ts -i http://127.0.0.1:3010/docs-json -o clients/typescript/src -c @hey-api/client-fetch",
    "client:check": "tsc -p clients/typescript/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.0",
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/platform-ws": "^11.2.5",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.2.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.0.0",
    "grammy": "^1.38.0",
    "ioredis": "^5.4.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.0"
  }
}
